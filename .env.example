# Site URL (canonical base for sitemap and OG metadata)
NEXT_PUBLIC_SITE_URL=https://picktherobot.com

# --- Google Search Console (optional) ---
# HTML tag verification: paste only the content value from Search Console
# (not the full meta tag). Example: abc123XYZ...
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics (optional — leave blank to disable) ---
# If either ID is set, a cookie consent banner appears before scripts load.
# Users must accept analytics before GA4 / Plausible run.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Plausible domain (e.g. picktherobot.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# API keys (optional — for manual/dev keys; Stripe checkout provisions subscriber keys)
# PICKTHEROBOT_API_KEY_STARTER=
# PICKTHEROBOT_API_KEY_PRO=
# Rate limits and monthly match quotas are enforced in-memory per server instance.
# OpenAPI spec: GET /api/v1/openapi.json
#
# Local API smoke test (PowerShell — use curl.exe, not curl):
#   powershell -File scripts/test-api.ps1

# --- Stripe (Starter $49/mo + Pro $149/mo API subscriptions) ---
# Create two Products with monthly Prices in your Stripe Dashboard (test mode first),
# or run checkout once after setting STRIPE_SECRET_KEY — products must exist on the same account.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from: stripe listen --forward-to localhost:3005/api/stripe/webhook
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# If checkout fails with a Managed Payments / tax_code error, the app disables managed_payments
# on Checkout sessions (standard Stripe). You can also disable it in Dashboard → Settings.

# --- Neon (API key persistence for Stripe subscribers) ---
# Create via Vercel → Storage → Neon, or: npx neonctl connection-string --project-id <id>
# Run migration once: node scripts/migrate-neon.mjs  (loads DATABASE_URL from .env.local)
# DATABASE_URL=postgresql://...
# API_KEY_ENCRYPTION_KEY=...   # required in production; encrypts pending API keys at rest
# STRIPE_VENDOR_VERIFIED_PRICE_ID=price_...
# STRIPE_VENDOR_SPONSORED_PRICE_ID=price_...
# Run: node scripts/stripe-setup-vendor.mjs
# VENDOR_SESSION_SECRET=...   # optional; falls back to API_KEY_ENCRYPTION_KEY

# --- Brevo (vendor magic-link login) ---
# Free tier: 300 emails/day, multiple domains at no extra cost.
# 1. Create account at brevo.com → SMTP & API → generate API key
# 2. Senders & Domains → verify picktherobot.com or vendors@picktherobot.com
# 3. node scripts/brevo-setup.mjs you@example.com
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM_EMAIL=PickTheRobot <vendors@picktherobot.com>

# Preview deploys should use a separate Neon branch via PREVIEW_DATABASE_URL when running set-vercel-env.mjs
# PREVIEW_DATABASE_URL=postgresql://...

# --- Stripe live mode (production only — keep separate from test keys) ---
# After activating live mode in Stripe Dashboard, add sk_live_... then run:
#   node scripts/stripe-setup-live.mjs
#   node scripts/set-vercel-env.mjs
# STRIPE_LIVE_SECRET_KEY=sk_live_...
# STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
# STRIPE_LIVE_STARTER_PRICE_ID=price_...
# STRIPE_LIVE_PRO_PRICE_ID=price_...

# Production checklist:
# 1. Add NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION, deploy, then verify in Search Console
# 2. Submit https://picktherobot.com/sitemap.xml in Search Console → Sitemaps
# 3. Enable analytics only after privacy policy is live
# 4. Prefer Plausible for lighter compliance; GA4 needs explicit consent in EU/UK
